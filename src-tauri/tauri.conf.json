{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Letterpress",
  "version": "0.1.0",
  "identifier": "com.marchettistudio.letterpress",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Letterpress",
        "width": 1360,
        "height": 880,
        "minWidth": 1360,
        "minHeight": 880,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
